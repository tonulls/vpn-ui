+func TestParseTrustedXForwardedFor(t *testing.T) {
+	header := http.Header{}
+	header.Add("X-Forwarded-For", "198.51.100.7, 10.0.0.2")
+	trusted := []string{"X-Forwarded-For", "proxy:127.0.0.1/32", "proxy:10.0.0.0/8"}
+
+	got := ParseTrustedXForwardedFor("127.0.0.1:12002", header, trusted)
+	want := []net.Address{net.ParseAddress("198.51.100.7")}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("trusted proxy chain mismatch (-want +got):\n%s", diff)
+	}
+
+	if got := ParseTrustedXForwardedFor("203.0.113.8:12002", header, trusted); len(got) != 0 {
+		t.Fatalf("untrusted peer headers were accepted: %#v", got)
+	}
+
+	realIPHeader := http.Header{"X-Real-Ip": []string{"198.51.100.9"}}
+	got = ParseTrustedXForwardedFor("127.0.0.1:12002", realIPHeader, []string{"X-Real-IP", "proxy:127.0.0.1/32"})
+	if diff := cmp.Diff([]net.Address{net.ParseAddress("198.51.100.9")}, got); diff != "" {
+		t.Fatalf("trusted X-Real-IP mismatch (-want +got):\n%s", diff)
+	}
+
+	forwardedHeader := http.Header{"Forwarded": []string{"for=198.51.100.10;proto=https, for=10.0.0.3"}}
+	got = ParseTrustedXForwardedFor("127.0.0.1:12002", forwardedHeader, []string{"Forwarded", "proxy:127.0.0.1/32", "proxy:10.0.0.0/8"})
+	if diff := cmp.Diff([]net.Address{net.ParseAddress("198.51.100.10")}, got); diff != "" {
+		t.Fatalf("trusted Forwarded chain mismatch (-want +got):\n%s", diff)
+	}
+
+	unlistedHeader := http.Header{
+		"X-Real-Ip":       []string{"not-an-ip"},
+		"X-Forwarded-For": []string{"198.51.100.11"},
+	}
+	got = ParseTrustedXForwardedFor("127.0.0.1:12002", unlistedHeader, []string{"X-Real-IP", "proxy:127.0.0.1/32"})
+	if len(got) != 0 {
+		t.Fatalf("unconfigured forwarding header was accepted: %#v", got)
+	}
+}
+
+func TestParseTrustedXForwardedForKeepsLegacyHeaderBehavior(t *testing.T) {
+	header := http.Header{"X-Forwarded-For": []string{"198.51.100.7, 10.0.0.2"}}
+	got := ParseTrustedXForwardedFor("203.0.113.8:12002", header, []string{"X-Forwarded-For"})
+	want := []net.Address{net.ParseAddress("198.51.100.7"), net.ParseAddress("10.0.0.2")}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("legacy header behavior mismatch (-want +got):\n%s", diff)
+	}
+}
