--- a/app/dispatcher/default.go
+++ b/app/dispatcher/default.go
@@ -2,6 +2,7 @@ package dispatcher
 
 import (
 	"context"
+	"encoding/base64"
 	"strings"
 	"sync"
 	"time"
@@ -27,6 +28,53 @@ import (
 
 var errSniffingTimeout = errors.New("timeout on sniffing")
 
+const inboundUserTrafficStatPrefix = "inbound-user>>>v1"
+
+// inboundUserTrafficStatName создает отдельное имя счетчика, не меняя
+// существующие счетчики Xray user>>>email>>>traffic>>>up/down.
+func inboundUserTrafficStatName(tag, identityType, identity, direction string) string {
+	if tag == "" || identityType == "" || identity == "" || direction == "" {
+		return ""
+	}
+	encode := base64.RawURLEncoding.EncodeToString
+	return inboundUserTrafficStatPrefix + ">>>" + identityType + ">>>" + encode([]byte(tag)) + ">>>" + encode([]byte(identity)) + ">>>traffic>>>" + direction
+}
+
+// inboundUserTrafficIdentity отделяет peer WireGuard от аутентифицированного
+// пользователя: Xray помещает tunnel IP в Source, оставляя User nil.
+func inboundUserTrafficIdentity(inbound *session.Inbound, user *protocol.MemoryUser) (string, string) {
+	if user != nil && user.Email != "" {
+		return "email", user.Email
+	}
+	if inbound != nil && inbound.Name == "wireguard" && inbound.Source.Address.Family().IsIP() {
+		return "wireguard-ip", inbound.Source.Address.String()
+	}
+	return "", ""
+}
+
+func registerInboundUserTrafficCounter(
+	sm stats.Manager,
+	inbound *session.Inbound,
+	user *protocol.MemoryUser,
+	direction string,
+) stats.Counter {
+	if sm == nil || inbound == nil {
+		return nil
+	}
+	identityType, identity := inboundUserTrafficIdentity(inbound, user)
+	name := inboundUserTrafficStatName(inbound.Tag, identityType, identity, direction)
+	if name == "" {
+		return nil
+	}
+	counter, err := stats.GetOrRegisterCounter(sm, name)
+	if err != nil {
+		// Первые параллельные соединения могут одновременно создать этот ключ;
+		// используем уже созданный счетчик, чтобы не потерять трафик соединения.
+		return sm.GetCounter(name)
+	}
+	return counter
+}
+
 type cachedReader struct {
 	sync.Mutex
 	reader buf.TimeoutReader // *pipe.Reader or *buf.TimeoutWrapperReader
@@ -185,6 +233,13 @@ func (d *DefaultDispatcher) getLink(ctx context.Context) (*transport.Link, *tran
 		}
 	}
 
+	if c := registerInboundUserTrafficCounter(d.stats, sessionInbound, user, "uplink"); c != nil {
+		inboundLink.Writer = &SizeStatWriter{Counter: c, Writer: inboundLink.Writer}
+	}
+	if c := registerInboundUserTrafficCounter(d.stats, sessionInbound, user, "downlink"); c != nil {
+		outboundLink.Writer = &SizeStatWriter{Counter: c, Writer: outboundLink.Writer}
+	}
+
 	// Speed limiting is keyed by account email, so one bucket covers every
 	// connection an account has open. It is looked up outside the block above
 	// because it must also fire when the email is empty: see LookupSession.
@@ -239,5 +294,12 @@ func WrapLink(ctx context.Context, policyManager policy.Manager, statsManager st
 		}
 	}
 
+	if c := registerInboundUserTrafficCounter(statsManager, sessionInbound, user, "uplink"); c != nil {
+		link.Reader = &buf.TimeoutWrapperReader{Reader: link.Reader, Counter: c}
+	}
+	if c := registerInboundUserTrafficCounter(statsManager, sessionInbound, user, "downlink"); c != nil {
+		link.Writer = &SizeStatWriter{Counter: c, Writer: link.Writer}
+	}
+
 	return link
 }
