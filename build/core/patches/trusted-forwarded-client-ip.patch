+func parseForwardedIP(value string) stdnet.IP {
+	if len(value) >= 2 && value[0] == '"' && value[len(value)-1] == '"' {
+		unquoted, err := strconv.Unquote(value)
+		if err != nil {
+			return nil
+		}
+		value = unquoted
+	}
+	if strings.EqualFold(value, "unknown") || strings.HasPrefix(value, "_") {
+		return nil
+	}
+	if host, _, err := stdnet.SplitHostPort(value); err == nil {
+		value = host
+	}
+	return stdnet.ParseIP(strings.Trim(strings.TrimSpace(value), "[]"))
+}
+
+func parseProxyPeer(remoteAddr string) stdnet.IP {
+	host, _, err := stdnet.SplitHostPort(remoteAddr)
+	if err == nil {
+		return stdnet.ParseIP(host)
+	}
+	return stdnet.ParseIP(strings.Trim(strings.TrimSpace(remoteAddr), "[]"))
+}
+
+func isTrustedProxy(ip stdnet.IP, networks []*stdnet.IPNet) bool {
+	for _, network := range networks {
+		if network.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
